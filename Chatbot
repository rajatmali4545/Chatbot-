import json
import math
import os
import re
from collections import Counter

JSON_FILE_PATH = "knowledge_base.json"

def load_knowledge_base(file_path):
    if not os.path.exists(file_path):
        print(f"❌ Error: Could not find '{file_path}' in the current folder.")
        return None

    try:
        with open(file_path, "r", encoding="utf-8") as f:
            data = json.load(f)
            print(f"✅ Successfully loaded: {file_path}")
            return data
    except json.JSONDecodeError as e:
        print(f"❌ Invalid JSON format in '{file_path}': {e}")
        return None


def tokenize(text):
    """Normalizes text and breaks it into words with basic suffix stemming."""
    text = str(text).lower()
    words = re.findall(r"\b\w+\b", text)

    # Basic suffix stripping for light stemming (e.g., lists -> list, running -> run)
    stemmed = []
    for word in words:
        if len(word) > 3:
            if word.endswith("s"):
                word = word[:-1]
            elif word.endswith("ing"):
                word = word[:-3]
            elif word.endswith("ed"):
                word = word[:-2]
        stemmed.append(word)

    return stemmed


def compute_tf(tokens):
    """Computes Term Frequency."""
    tf_dict = Counter(tokens)
    total = len(tokens)
    return {word: count / total for word, count in tf_dict.items()} if total > 0 else {}


def compute_idf(corpus):
    """Computes Inverse Document Frequency across all searchable items."""
    N = len(corpus)
    all_words = set(word for doc in corpus for word in doc)
    idf_dict = {}

    for word in all_words:
        doc_count = sum(1 for doc in corpus if word in doc)
        idf_dict[word] = math.log((N + 1) / (doc_count + 1)) + 1  # Smooth IDF

    return idf_dict


def cosine_similarity(vec1, vec2):
    """Calculates cosine similarity between two vector dictionaries."""
    intersection = set(vec1.keys()) & set(vec2.keys())
    numerator = sum([vec1[x] * vec2[x] for x in intersection])

    sum1 = sum([val**2 for val in vec1.values()])
    sum2 = sum([val**2 for val in vec2.values()])
    denominator = math.sqrt(sum1) * math.sqrt(sum2)

    if not denominator:
        return 0.0
    return numerator / denominator


def flatten_knowledge_base(data):
    """Parses various JSON structures into a unified list of searchable items."""
    flat_list = []

    if isinstance(data, list):
        for item in data:
            if isinstance(item, dict):
                flat_list.append(item)

    elif isinstance(data, dict):
        if "questions" in data and isinstance(data["questions"], list):
            flat_list.extend(
                [q for q in data["questions"] if isinstance(q, dict)]
            )

        if "topics" in data and isinstance(data["topics"], list):
            for topic in data["topics"]:
                if isinstance(topic, dict):
                    flat_list.append(topic)

        if not flat_list:
            for key, val in data.items():
                if isinstance(val, dict):
                    item = val.copy()
                    item.setdefault("topic", key)
                    flat_list.append(item)

    return flat_list


class SearchEngine:

    def __init__(self, searchable_items):
        self.items = searchable_items
        self.documents = []

        # Prepare combined text representations for each item
        for item in self.items:
            doc_parts = []
            if "topic" in item:
                doc_parts.append(str(item["topic"]) * 3)  # Give extra weight to topic
            if "question" in item:
                doc_parts.append(str(item["question"]) * 2)
            if "questions" in item and isinstance(item["questions"], list):
                doc_parts.extend([str(q) for q in item["questions"]])
            if "keywords" in item and isinstance(item["keywords"], list):
                doc_parts.extend(item["keywords"] * 2)
            if "short_answer" in item:
                doc_parts.append(str(item["short_answer"]))

            combined_text = " ".join(doc_parts)
            self.documents.append(tokenize(combined_text))

        self.idf = compute_idf(self.documents)
        self.doc_vectors = [self._vectorize(doc) for doc in self.documents]

    def _vectorize(self, tokens):
        tf = compute_tf(tokens)
        return {word: tf[word] * self.idf.get(word, 0) for word in tokens}

    def search(self, query):
        query_tokens = tokenize(query)
        if not query_tokens:
            return None, 0.0

        query_vec = self._vectorize(query_tokens)

        best_item = None
        best_score = 0.0

        for idx, doc_vec in enumerate(self.doc_vectors):
            score = cosine_similarity(query_vec, doc_vec)

            # Direct topic / question word-overlap boost
            item = self.items[idx]
            query_set = set(query_tokens)
            if "topic" in item and set(tokenize(item["topic"])) & query_set:
                score += 0.15

            if score > best_score:
                best_score = score
                best_item = item

        return best_item, best_score



def format_answer(item):
    if not item:
        return "I couldn't find an answer to that."

    if "answer" in item:
        ans = item["answer"]
        if isinstance(ans, str):
            return ans.strip()
        elif isinstance(ans, dict):
            return "\n".join([f"{k.title()}: {v}" for k, v in ans.items()])

    output = []
    if "topic" in item:
        output.append(f"--- {item['topic'].upper()} ---")
    if "short_answer" in item:
        output.append(f"\n{item['short_answer']}")
    if "explanation" in item:
        output.append(f"\n{item['explanation']}")
    if "syntax" in item:
        output.append(f"\nSyntax:\n{item['syntax']}")
    if "examples" in item:
        output.append("\nExample:")
        exs = (
            item["examples"]
            if isinstance(item["examples"], list)
            else [item["examples"]]
        )
        for ex in exs:
            if isinstance(ex, dict):
                output.append(f"{ex.get('code', '')}")
                if "explanation" in ex:
                    output.append(ex["explanation"])
            else:
                output.append(f"{ex}")

    if output:
        return "\n".join(output)

    return json.dumps(item, indent=2)



def main():
    knowledge_base = load_knowledge_base(JSON_FILE_PATH)

    if not knowledge_base:
        return

    searchable_items = flatten_knowledge_base(knowledge_base)
    engine = SearchEngine(searchable_items)

    print("\n" + "=" * 50)
    print("🐍 PYTHON CHATBOT READY (TF-IDF ENGINE)")
    print("=" * 50)
    print("Type 'exit' or 'quit' to close.\n")

    while True:
        try:
            user_input = input("You: ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nBot: Goodbye! 👋")
            break

        if user_input.lower() in ["exit", "quit"]:
            print("\nBot: Goodbye! 👋")
            break

        if not user_input:
            continue

        matched_item, score = engine.search(user_input)

        # Threshold set to 0.1 for TF-IDF cosine similarity
        if matched_item is None or score < 0.1:
            print("\nBot: ❌ Sorry, no matching answer found.\n")
        else:
            answer = format_answer(matched_item)
            print(f"\nBot:\n{answer}\n")
            print("-" * 50)


if __name__ == "__main__":
    main()
